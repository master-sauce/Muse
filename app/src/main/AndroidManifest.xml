<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Storage — legacy (≤ API 32) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Storage — modern (API 33+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Keeps the download process alive when the app is closed -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Media notification (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MuseApp"
        android:allowBackup="true"
        android:appCategory="audio"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.Muse"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true">

        <!-- Playback service.

             Registered twice on purpose:
             · androidx.media3.session.MediaSessionService — the modern
               MediaController / MediaSession path used inside the app.
             · android.media.browse.MediaBrowserService — the legacy
               MediaBrowserService entry point the OS, Android Auto, Wear OS,
               Assistant and other media apps use to discover Muse as a
               music app. MediaSessionService.onBind() serves this action
               itself (returns the session's legacy browser binder).

             DEFAULT category is required by the system's media service
             lookup; without it the service is never listed. -->
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:label="@string/app_name"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Download service: keeps the process alive so downloads continue
             even when the app is closed. The actual download work lives in
             DownloadState; this service only holds the foreground slot. -->
        <service
            android:name=".player.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Keeps the process alive while the library is migrated into the
             user's folder (Download/Muse) and hosts the Cancel action of the
             ongoing migration notification. -->
        <service
            android:name=".player.MigrationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Receives the Cancel action from download progress notifications.
             Not exported: only the system notification action (same app) fires it. -->
        <receiver
            android:name=".downloader.DownloadCancelReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.Music.action.CANCEL_DOWNLOAD" />
            </intent-filter>
        </receiver>

        <!-- FileProvider — required for sharing song files via ACTION_SEND -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Muse"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
    </application>

</manifest>